<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RblHost.Examples.GetProperty</RootNamespace>
    <AssemblyName>get_property</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by `cargo build` with the csharp feature enabled (see root README, "Building C# bindings"). -->
    <Compile Include="../../bindings/csharp/NativeMethods.g.cs" Link="NativeMethods.g.cs" />
  </ItemGroup>

</Project>
